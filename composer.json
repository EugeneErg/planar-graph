{
    "name": "eugene-erg/graphs",
    "type": "project",
    "description": "Planar graphs: планарная укладка графа и её отрисовка в анимированный SVG",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*"
    },
    "autoload": {
        "psr-4": {
            "EugeneErg\\Graphs\\": "src/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.58",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@test",
            "@stan",
            "@cs"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
